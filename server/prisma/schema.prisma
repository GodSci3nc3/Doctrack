generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model caso {
  caso_id          Int               @id @default(autoincrement())
  cliente_id       Int
  tipo_tramite     String            @db.VarChar(100)
  estado           String            @default("PENDIENTE") @db.VarChar(50)
  fecha_creacion   DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  fecha_aprobacion DateTime?         @db.Date
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @default(now()) @db.Timestamp(6)
  cliente          cliente           @relation(fields: [cliente_id], references: [cliente_id], onDelete: Cascade, map: "fk_caso_cliente")
  documento        documento[]
  historialaccion  historialaccion[]

  @@index([cliente_id], map: "idx_caso_cliente")
  @@index([estado], map: "idx_caso_estado")
  @@index([tipo_tramite], map: "idx_caso_tipo")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cliente {
  cliente_id    Int        @id @default(autoincrement())
  nombre        String     @db.VarChar(100)
  apellido      String     @db.VarChar(100)
  email         String     @unique @db.VarChar(255)
  telefono      String?    @db.VarChar(20)
  canal_ingreso String?    @db.VarChar(50)
  created_by    Int        // NUEVO CAMPO - ID del usuario que creó el cliente
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  updated_at    DateTime?  @default(now()) @db.Timestamp(6)

  // --- Datos personales ---
  encargado                String?    @db.VarChar(100)
  tipo_proceso             String?    @db.VarChar(100)
  tipo_documento           String?    @db.VarChar(50)
  numero_documento         String?    @db.VarChar(50)
  pais_origen              String?    @db.VarChar(100)
  pais_nacimiento          String?    @db.VarChar(100)
  fecha_nacimiento         DateTime?
  estado_civil             String?    @db.VarChar(50)
  direccion_actual         String?    @db.VarChar(255)
  estado                   String?    @db.VarChar(50)
  zipcode                  String?    @db.VarChar(20)
  ciudad                   String?    @db.VarChar(100)

  // --- Datos migratorios ---
  migratorio_tipo_proceso      String?    @db.VarChar(100)
  migratorio_ubicacion_actual  String?    @db.VarChar(100)
  migratorio_estatus_actual    String?    @db.VarChar(50)
  migratorio_numero_caso       String?    @db.VarChar(50)
  migratorio_fecha_entrada_eeuu DateTime?
  migratorio_via_entrada_eeuu  String?    @db.VarChar(50)
  migratorio_fecha_vencimiento_estadia DateTime?
  migratorio_dependientes      String?    @db.VarChar(255)

  // --- Estudios y datos adicionales ---
  ocupacion_actual         String?    @db.VarChar(100)
  nivel_estudios           String?    @db.VarChar(100)
  forma_contacto           String?    @db.VarChar(50)
  notas_cliente            String?    @db.VarChar(1000)

  // Relaciones existentes
  caso          caso[]
  contrato      contrato[]
  pago          pago[]

  // NUEVA RELACIÓN - Cliente pertenece a un usuario
  usuario       usuariointerno @relation(fields: [created_by], references: [usuario_id], onDelete: Cascade)

  @@index([email], map: "idx_cliente_email")
  @@index([nombre, apellido], map: "idx_cliente_nombre_apellido")
  @@index([created_by], map: "idx_cliente_created_by") // NUEVO ÍNDICE
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model contrato {
  contrato_id  Int       @id @default(autoincrement())
  cliente_id   Int
  fecha_inicio DateTime  @db.Date
  fecha_fin    DateTime? @db.Date
  detalles     String?
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  cliente      cliente   @relation(fields: [cliente_id], references: [cliente_id], onDelete: Cascade, map: "fk_contrato_cliente")

  @@index([cliente_id], map: "idx_contrato_cliente")
  @@index([fecha_inicio, fecha_fin], map: "idx_contrato_fechas")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model documento {
  documento_id           Int       @id @default(autoincrement())
  caso_id                Int
  tipo                   String    @db.VarChar(100)
  nombre_personalizado   String?   @db.VarChar(200)  // NUEVA
  nombre_archivo_original String?  @db.VarChar(200)  // NUEVA
  ruta_storage           String?   @db.VarChar(500)  // NUEVA
  tamaño_bytes           Int?                        // NUEVA
  tipo_archivo           String?   @db.VarChar(50)   // NUEVA
  fecha_recibido         DateTime? @db.Date
  fecha_enviado          DateTime? @db.Date
  firma_digital          Boolean?  @default(false)
  url_documento          String?   @db.VarChar(500)
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  updated_at             DateTime? @default(now()) @db.Timestamp(6)
  caso                   caso      @relation(fields: [caso_id], references: [caso_id], onDelete: Cascade, map: "fk_documento_caso")

  @@index([caso_id], map: "idx_documento_caso")
  @@index([tipo], map: "idx_documento_tipo")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model historialaccion {
  accion_id         Int            @id @default(autoincrement())
  caso_id           Int
  usuario_id        Int
  tipo_comunicacion String         @db.VarChar(100)
  fecha             DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  descripcion       String?
  created_at        DateTime?      @default(now()) @db.Timestamp(6)
  caso              caso           @relation(fields: [caso_id], references: [caso_id], onDelete: Cascade, map: "fk_historial_caso")
  usuariointerno    usuariointerno @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, map: "fk_historial_usuario")

  @@index([caso_id], map: "idx_historial_caso")
  @@index([fecha], map: "idx_historial_fecha")
  @@index([usuario_id], map: "idx_historial_usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model pago {
  pago_id    Int       @id @default(autoincrement())
  cliente_id Int
  monto      Decimal   @db.Decimal(12, 2)
  fecha_pago DateTime  @db.Date
  metodo     String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  cliente    cliente   @relation(fields: [cliente_id], references: [cliente_id], onDelete: Cascade, map: "fk_pago_cliente")

  @@index([cliente_id], map: "idx_pago_cliente")
  @@index([fecha_pago], map: "idx_pago_fecha")
}
model usuariointerno {
  usuario_id      Int               @id @default(autoincrement())
  nombre          String            @db.VarChar(100)
  apellido        String            @db.VarChar(100)
  email           String            @unique @db.VarChar(255)
  rol             String            @db.VarChar(50)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  contrase_a      String            @map("contraseña") @db.VarChar(255)
  
  // Relaciones existentes
  historialaccion historialaccion[]
  
  // NUEVA RELACIÓN - Usuario tiene muchos clientes
  clientes        cliente[]
}
